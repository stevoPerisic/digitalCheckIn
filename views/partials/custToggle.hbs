<!-- custom choice inputs via https://bootsnipp.com/snippets/NBN6x-->
<div class="input-group" style="width: 100%;">
    <label for="{{id}}">{{label}}</label>
    <br>
    <div class="radioBtn btn-group" style="width: 100%;">
        <span style="width: 50%;" class="btn btn-primary active"
              data-toggle="{{id}}" data-value="{{dataVal1}}">{{choice1}}</span>
        <span style="width: 50%;" class="btn btn-default notActive"
              data-toggle="{{id}}" data-value="{{dataVal2}}">{{choice2}}</span>
    </div>
    <input type="hidden" name="{{id}}" id="{{id}}">
</div>