<div class="form-check">
    <label class="custChkBx form-check-label row">
        <span class="col-xs-2 col-sm-3 col-md-3">
            <span class="custChkBx chkBx
                {{#if allergies}}
                    {{#checkAllergy allergies text=text className="checked"}}checked{{/checkAllergy}}
                {{/if}}
            ">
                <i class="custChkBx glyphicon glyphicon-ok"></i>
            </span>
        </span>
        <span class="col-xs-10 col-sm-8 col-md-9">
            {{text}}
            <input type="checkbox"
                    {{#if dataType}}
                        data-type="{{dataType}}"
                    {{/if}}
                    {{#if dataRel}}
                       data-rel="{{dataRel}}"
                    {{/if}}
                    {{#if allergies}}
                        {{#checkAllergy allergies text=text className="checked"}}checked{{/checkAllergy}}
                    {{/if}}
                   class="custChkBx form-check-input"
                    {{#if dataValue}}
                        value="{{dataValue}}"
                    {{else}}
                        value="{{text}}"
                    {{/if}}
            />
        </span>
    </label>
</div>