<div class="row">
    <div class="col-sm-12">

        <h1>Medicare Annual Wellness Visit Questionnaire</h1>

        <form>
<!--Patient demographics-->
            <div class="panel-group" id="accordion" role="tablist" aria-multiselectable="true">
                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingOne">
                        <h4 class="panel-title">
                            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseOne"
                               aria-expanded="true" aria-controls="collapseOne">
                                Patient demographics
                            </a>
                        </h4>
                    </div>
                    <div id="collapseOne" class="panel-collapse collapse in" role="tabpanel"
                         aria-labelledby="headingOne">
                        <div class="panel-body">
                            <div class="row">
                                <div class="col-sm-3">
                                    {{> custInputFld type="text" id="lastname" label="Last name" placeholder="Last name"}}
                                </div>
                                <div class="col-sm-3">
                                    {{> custInputFld type="text" id="firstname" label="First name" placeholder="First name"}}
                                </div>
                                <div class="col-sm-3">
                                    {{> custInputFld type="text" id="middleinitial" label="Middle initial" placeholder="Middle initial"}}
                                </div>
                                <div class="col-sm-3">
                                    {{> custInputFld type="tel" id="ssn" label="SSN" placeholder="*** - ** - ****"}}
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-6">
                                    {{> custInputFld type="text" id="streetaddress" label="Street address" placeholder="3000 Sunny LN #1-B"}}
                                </div>
                                <div class="col-sm-3">
                                    {{> custInputFld type="text" id="city" label="City" placeholder="Atlanta"}}
                                </div>
                                <div class="col-sm-3">
                                    {{> custInputFld type="text" id="zipcode" label="ZIP Code" placeholder="30675"}}
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-3">
                                    {{> custInputFld type="tel" id="homephone" label="Home phone" placeholder="(***) *** - ****"}}
                                </div>
                                <div class="col-sm-3">
                                    {{> custInputFld type="tel" id="cellphone" label="Cell phone" placeholder="(***) *** - ****"}}
                                </div>
                                <div class="col-sm-3">
                                    {{> custToggle id="sex" label="Sex" dataVal1="Male" choice1="Male" dataVal2="Female" choice2="Female"}}
                                </div>
                                <div class="col-sm-3">
                                    {{> custInputFld type="text" id="referredBy" label="Referred by" placeholder=""}}
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-3">
                                    {{> custInputFld type="text" id="nextOfKin" label="Next of Kin (for emergency)" placeholder=""}}
                                </div>
                                <div class="col-sm-3">
                                    {{> custInputFld type="tel" id="nextOfKinPhone" label="Contact phone" placeholder="(***) *** - ****"}}
                                </div>
                                <div class="col-sm-3">
                                    {{> custInputFld type="text" id="nameOfSpouse" label="Name of spouse (if applicable)" placeholder=""}}
                                </div>
                                <div class="col-sm-3">
                                    {{> custInputFld type="tel" id="spouseDayPhone" label="Contact phone" placeholder="(***) *** - ****"}}
                                </div>
                            </div>

                            <div class="row">
                                <fieldset>
                                    <legend class="col-sm-12">Insurance</legend>
                                    <div class="col-sm-3">
                                        {{> custInputFld type="text" id="primaryInsuranceName" label="Primary Insurance name" placeholder=""}}
                                    </div>
                                    <div class="col-sm-3">
                                        {{> custInputFld type="tel" id="insurancePhone" label="Phone number" placeholder="(***) *** - ****"}}
                                    </div>
                                    <div class="col-sm-3">
                                        {{> custInputFld type="text" id="groupNumber" label="Group Number" placeholder=""}}
                                    </div>
                                    <div class="col-sm-3">
                                        {{> custInputFld type="text" id="idNumber" label="ID Number" placeholder=""}}
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                    </div>
                </div>
<!-- Current Medical Problems -->
                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingTwo">
                        <h4 class="panel-title">
                            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo"
                               aria-expanded="true" aria-controls="collapseTwo">
                                Current Medical Problems
                            </a>
                        </h4>
                    </div>
                    <div id="collapseTwo" class="panel-collapse collapse in" role="tabpanel"
                         aria-labelledby="headingTwo">
                        <div class="panel-body">
                            <p>List any current medical problems or conditions</p>
                            {{> custListInput inputId="condition" listClass="conditionList" label="Condition"
                                    placeholder="Condition" btnLabel="Add"}}
                        </div>
                    </div>
                </div>
<!-- Past medical history -->
                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingThree">
                        <h4 class="panel-title">
                            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseThree"
                               aria-expanded="true" aria-controls="collapseThree">
                                Past Medical History
                            </a>
                        </h4>
                    </div>
                    <div id="collapseThree" class="panel-collapse collapse in" role="tabpanel"
                         aria-labelledby="headingThree">
                        <div class="panel-body">
                            <div class="row">
                                <div class="col-sm-6">
                                    <p>Childhood Illnesses</p>
                                    {{> custListInput inputId="childhoodIllness" listClass="childhoodIllnessesList"
                                            label="Childhood Illnesses" placeholder="Childhood Illness" btnLabel="Add"}}
                                </div>
                                <div class="col-sm-6">
                                    <p>Chronic Illnesses</p>
                                    {{> custListInput inputId="chronicIllness" listClass="chronicIllnessList"
                                            label="Chronic Illnesses" placeholder="Chronic Illness" btnLabel="Add"}}
                                </div>
                            </div>
                            <hr>
                            <div class="row">
                                <div class="col-sm-6">
                                    <p>Past surgeries</p>
                                    {{> custListInput inputId="surgeryName" listClass="surgeryNameList"
                                            label="Surgery" placeholder="Surgery" btnLabel="Add"
                                            showCalendar=true calendarId="surgeryDate" calendarLabel="Surgery date"}}
                                </div>
                                <div class="col-sm-6">
                                    <p>List any other hospital stays</p>
                                    {{> custListInput inputId="reason" listClass="reasonList"
                                            label="Reason" placeholder="Reason" btnLabel="Add"
                                            showCalendar=true calendarId="hospitalStayDate" calendarLabel="Date"}}
                                </div>
                            </div>
                            <hr>
                            <div class="row">
                                <div class="col-sm-6">
                                    <p>Physicians/practitioners you currently see</p>
                                    <div class="form-inline">
                                        <div class="form-group mx-sm-3">
                                            <label for="physName" class="sr-only">Name</label>
                                            <input type="text" class="form-control" id="physName" placeholder="Name">

                                            <label for="physSpecialty" class="sr-only">Specialty</label>
                                            <input type="text" class="form-control" id="physSpecialty" placeholder="Specialty">
                                        </div>
                                        <button type="submit" class="btn btn-primary">Add</button>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    {{> custInputFld type="date" id="lastEyeExam" label="Last Eye/Glaucoma Exam" placeholder="mm/dd/yyyy"}}
                                </div>
                            </div>


                        </div>
                    </div>
                </div>
<!-- Allergies -->
                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingFour">
                        <h4 class="panel-title">
                            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseFour"
                               aria-expanded="true" aria-controls="collapseFour">
                                Allergies
                            </a>
                        </h4>
                    </div>
                    <div id="collapseFour" class="panel-collapse collapse in" role="tabpanel"
                         aria-labelledby="headingFour">
                        <div class="panel-body">
                            <p>List any allergies to medication, x-ray dyes or food.</p>
                            <div class="form-inline">
                                <div class="form-group mx-sm-3">
                                    <label for="allergy" class="sr-only">Allergy</label>
                                    <input type="text" class="form-control" id="allergy" placeholder="Allergy">

                                    <label for="reactions" class="sr-only">Reaction</label>
                                    <input type="text" class="form-control" id="reactions" placeholder="Reaction">
                                </div>
                                <button type="submit" class="btn btn-primary">Add</button>
                            </div>
                        </div>
                    </div>
                </div>
<!-- Medications -->
                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingFive">
                        <h4 class="panel-title">
                            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseFive"
                               aria-expanded="true" aria-controls="collapseFive">
                                Medications
                            </a>
                        </h4>
                    </div>
                    <div id="collapseFive" class="panel-collapse collapse in" role="tabpanel"
                         aria-labelledby="headingFive">
                        <div class="panel-body">
                            <p>List any medication that you currently take, including over-the-counter.</p>
                            <div class="form-inline">
                                <div class="form-group mx-sm-3">
                                    <label for="physName" class="sr-only">Name</label>
                                    <input type="text" class="form-control" id="physName" placeholder="Name">

                                    <label for="medStrength" class="sr-only">Strength</label>
                                    <input type="text" class="form-control" id="medStrength" placeholder="Strength">

                                    <label for="medDirection" class="sr-only">Direction</label>
                                    <input type="text" class="form-control" id="medDirection" placeholder="Direction">

                                    <label for="medPrescribedBy" class="sr-only">Prescribed by</label>
                                    <input type="text" class="form-control" id="medPrescribedBy" placeholder="Prescribed by">
                                </div>
                                <button type="submit" class="btn btn-primary">Add</button>
                            </div>
                        </div>
                    </div>
                </div>
<!-- Social History -->
                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingSix">
                        <h4 class="panel-title">
                            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseSix"
                               aria-expanded="true" aria-controls="collapseSix">
                                Social History
                            </a>
                        </h4>
                    </div>
                    <div id="collapseSix" class="panel-collapse collapse in" role="tabpanel"
                         aria-labelledby="headingSix">
                        <div class="panel-body">
                            <fieldset class="form-group">
                                <legend>Do you drink alcohol?</legend>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="radio" class="form-check-input" name="optionsRadios"
                                               id="optionsRadios1"
                                               value="option1" checked>
                                        No
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="radio" class="form-check-input" name="optionsRadios"
                                               id="optionsRadios2"
                                               value="option2">
                                        Yes
                                    </label>
                                </div>
                                <div class="form-group">
                                    <label for="alcoholAmount">If yes how much?</label>
                                    <input type="text" class="form-control" id="alcoholAmount"
                                           name="alcoholAmount"
                                           aria-describedby="alcoholAmount" placeholder="">
                                </div>
                            </fieldset>

                            <fieldset class="form-group">
                                <legend>Are others concerend about your drinking?</legend>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="radio" class="form-check-input" name="optionsRadios"
                                               id="optionsRadios3"
                                               value="option1" checked>
                                        No
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="radio" class="form-check-input" name="optionsRadios"
                                               id="optionsRadios4"
                                               value="option2">
                                        Yes
                                    </label>
                                </div>
                            </fieldset>

                            <fieldset class="form-group">
                                <legend>Diet:</legend>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Balanced
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Vegetarian
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Diabetic
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Low salt
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Low fat
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Low carb
                                    </label>
                                </div>
                                <div class="form-check form-inline">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Other:
                                    </label>
                                    <input type="text">
                                </div>
                            </fieldset>

                            <fieldset class="form-group">
                                <legend>Education:</legend>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        High School
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        College
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Some College
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Trade School
                                    </label>
                                </div>
                                <div class="form-check form-inline">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Other:
                                    </label>
                                    <input type="text">
                                </div>
                            </fieldset>

                            <fieldset class="form-group">
                                <legend>Do you do some form of regular exercise every day?</legend>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        No
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Yes
                                    </label>
                                </div>
                                <div class="form-check form-inline">
                                    <label class="form-check-label">If yes, how much?</label>
                                    <input type="text">
                                </div>
                            </fieldset>

                            <!-- This could be pre-filled with data from other form -->
                            <fieldset>
                                <legend>Marital status</legend>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Single
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Married
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Divorced
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Widowed
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Separated
                                    </label>
                                </div>
                                <div class="form-check form-inline">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Other:
                                    </label>
                                    <input type="text">
                                </div>
                            </fieldset>

                            <br>

                            <div class="form-check form-inline">
                                <label class="form-check-label">
                                    <input type="checkbox" class="form-check-input">
                                    Occupation:
                                </label>
                                <input type="text">
                            </div>

                            <br>

                            <fieldset>
                                <legend>List everyone in your household including pets:</legend>
                                <div class="form-inline">
                                    <div class="form-group mx-sm-3">
                                        <label for="familyMember" class="sr-only">Family member</label>
                                        <input type="text" class="form-control" id="familyMember" placeholder="Family member">
                                    </div>
                                    <button type="submit" class="btn btn-primary">Add</button>
                                </div>
                            </fieldset>

                            <fieldset class="form-group">
                                <legend>Do you wear seatbelts?</legend>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        No
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Yes
                                    </label>
                                </div>
                            </fieldset>

                            <fieldset class="form-group">
                                <legend>Have you smoked or chewed tobacco?</legend>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        No
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input">
                                        Yes
                                    </label>
                                </div>
                                <div class="form-check form-inline">
                                    <label class="form-check-label">If yes, how much?</label>
                                    <input type="text">
                                </div>
                            </fieldset>

                            <h2>Routine Tasks: Please indicate if you do or do not need help performing these routine tasks</h2>

                            <ol>
                                <li>
                                    <fieldset>
                                        <legend>Feeding yourself</legend>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">No</label></div>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">Yes</label></div>
                                        <div class="form-inline"><label for="">If yes, who helps?</label><input
                                                type="text"></div>
                                    </fieldset>
                                </li>
                                <li>
                                    <fieldset>
                                        <legend>Getting from bed to chair</legend>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">No</label></div>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">Yes</label></div>
                                        <div class="form-inline"><label for="">If yes, who helps?</label><input
                                                type="text"></div>
                                    </fieldset>
                                </li>
                                <li>
                                    <fieldset>
                                        <legend>Getting to the toilet</legend>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">No</label></div>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">Yes</label></div>
                                        <div class="form-inline"><label for="">If yes, who helps?</label><input
                                                type="text"></div>
                                    </fieldset>
                                </li>
                                <li>
                                    <fieldset>
                                        <legend>Getting dressed</legend>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">No</label></div>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">Yes</label></div>
                                        <div class="form-inline"><label for="">If yes, who helps?</label><input
                                                type="text"></div>
                                    </fieldset>
                                </li>
                                <li>
                                    <fieldset>
                                        <legend>Bathing or showering</legend>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">No</label></div>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">Yes</label></div>
                                        <div class="form-inline"><label for="">If yes, who helps?</label><input
                                                type="text"></div>
                                    </fieldset>
                                </li>
                                <li>
                                    <fieldset>
                                        <legend>Walking across the room (includes using cane or walker)</legend>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">No</label></div>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">Yes</label></div>
                                        <div class="form-inline"><label for="">If yes, who helps?</label><input
                                                type="text"></div>
                                    </fieldset>
                                </li>
                                <li>
                                    <fieldset>
                                        <legend>Using the telephone</legend>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">No</label></div>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">Yes</label></div>
                                        <div class="form-inline"><label for="">If yes, who helps?</label><input
                                                type="text"></div>
                                    </fieldset>
                                </li>
                                <li>
                                    <fieldset>
                                        <legend>Taking your medication</legend>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">No</label></div>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">Yes</label></div>
                                        <div class="form-inline"><label for="">If yes, who helps?</label><input
                                                type="text"></div>
                                    </fieldset>
                                </li>
                                <li>
                                    <fieldset>
                                        <legend>Preparing meals</legend>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">No</label></div>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">Yes</label></div>
                                        <div class="form-inline"><label for="">If yes, who helps?</label><input
                                                type="text"></div>
                                    </fieldset>
                                </li>
                                <li>
                                    <fieldset>
                                        <legend>Managing money (like keeping track of expenses or paying bills)</legend>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">No</label></div>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">Yes</label></div>
                                        <div class="form-inline"><label for="">If yes, who helps?</label><input
                                                type="text"></div>
                                    </fieldset>
                                </li>
                                <li>
                                    <fieldset>
                                        <legend>Moderately strenuous housework such as doing laundry</legend>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">No</label></div>
                                        <div class="form-check"><label for="" class="form-check-label"><input
                                                type="checkbox" class="form-check-input">Yes</label></div>
                                        <div class="form-inline"><label for="">If yes, who helps?</label><input
                                                type="text"></div>
                                    </fieldset>
                                </li>
                                <li>
                                    <fieldset>
