                                            dataVal2="NO" choice2="NO"
                                            dataVal3="SOMETIMES" choice3="SOMETIMES"}}
                                </div>
                            </div>
                            {{> accBtnNext text="Next"}}
                        </div>
                    </div>
                </div>
<!-- Depression Screening -->
                <div class="panel panel-default">
