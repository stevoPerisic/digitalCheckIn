<!-- Hearing -->
                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingNine">
                        <h4 class="panel-title">
                            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseNine"
                               aria-expanded="true" aria-controls="collapseNine">
                                Hearing
                            </a>
                        </h4>
                    </div>
                    <div id="collapseNine" class="panel-collapse collapse" role="tabpanel"
                         aria-labelledby="headingNine">
                        <div class="panel-body">
                            <div class="row">
                                <div class="col-sm-12">
                                    <p>Please check YES, NO or SOMETIMES for <u>each</u> question:</p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4">
                                    {{> custToggle id="followConversation"
                                            label="Do you find it difficult to follow a conversation in a noisy restaurant or crowded room?"
                                            dataVal1="YES" choice1="YES"
                                            dataVal2="NO" choice2="NO"
                                            dataVal3="SOMETIMES" choice3="SOMETIMES"}}
                                </div>
                                <div class="col-sm-4">
                                    {{> custToggle id="pplMumbling"
                                            label="Do you sometimes feel that people are mumbling or not speaking clearly?"
                                            dataVal1="YES" choice1="YES"
                                            dataVal2="NO" choice2="NO"
                                            dataVal3="SOMETIMES" choice3="SOMETIMES"}}
                                </div>
                                <div class="col-sm-4">
                                    {{> custToggle id="theaterHearing"
                                            label="Do you experience difficulty following dialogue in the theater?"
                                            dataVal1="YES" choice1="YES"
                                            dataVal2="NO" choice2="NO"
                                            dataVal3="SOMETIMES" choice3="SOMETIMES"}}
                                </div>
                            </div>
                            <hr>
                            <div class="row">
                                <div class="col-sm-4">
                                    {{> custToggle id="publicMeeting"
                                            label="Do you sometimes find it difficult to understand a speaker at a public meeting or religious service?"
                                            dataVal1="YES" choice1="YES"
                                            dataVal2="NO" choice2="NO"
                                            dataVal3="SOMETIMES" choice3="SOMETIMES"}}
                                </div>
                                <div class="col-sm-4">
                                    {{> custToggle id="pplRepeating"
                                            label="Do you find yourself asking people to speak up or repeat themselves?"
                                            dataVal1="YES" choice1="YES"
                                            dataVal2="NO" choice2="NO"
                                            dataVal3="SOMETIMES" choice3="SOMETIMES"}}
                                </div>
                                <div class="col-sm-4">
                                    {{> custToggle id="genderVoices"
                                            label="Do you find men's voices easier to understand than women's?"
                                            dataVal1="YES" choice1="YES"
                                            dataVal2="NO" choice2="NO"
                                            dataVal3="SOMETIMES" choice3="SOMETIMES"}}
                                </div>
                            </div>
                            <hr>
                            <div class="row">
                                <div class="col-sm-4">
                                    {{> custToggle id="whisperSpeech"
                                            label="Do you experience difficulty understanding soft or whispered speech?"
                                            dataVal1="YES" choice1="YES"
                                            dataVal2="NO" choice2="NO"
                                            dataVal3="SOMETIMES" choice3="SOMETIMES"}}
                                </div>
                                <div class="col-sm-4">
                                    {{> custToggle id="telephoneSpeech"
                                            label="Do you sometimes have difficulty understanding speech on the telephone?"
                                            dataVal1="YES" choice1="YES"
                                            dataVal2="NO" choice2="NO"
                                            dataVal3="SOMETIMES" choice3="SOMETIMES"}}
                                </div>
                                <div class="col-sm-4">
                                    {{> custToggle id="meetingNewPpl"
                                            label="Does a hearing problem cause you to feel embarrassed when meeting new people?"
                                            dataVal1="YES" choice1="YES"
                                            dataVal2="NO" choice2="NO"
                                            dataVal3="SOMETIMES" choice3="SOMETIMES"}}
                                </div>
                            </div>
                            <hr>
                            <div class="row">
                                <div class="col-sm-4">
                                    {{> custToggle id="hearingHandicap"
                                            label="Do you feel handicapped by a hearing problem?"
                                            dataVal1="YES" choice1="YES"
                                            dataVal2="NO" choice2="NO"
                                            dataVal3="SOMETIMES" choice3="SOMETIMES"}}
                                </div>
                                <div class="col-sm-4">
                                    {{> custToggle id="lessVisit"
                                            label="Does a hearing problem cause you to visit friends, relatives, or neighbors less often then you would like?"
                                            dataVal1="YES" choice1="YES"
                                            dataVal2="NO" choice2="NO"
                                            dataVal3="SOMETIMES" choice3="SOMETIMES"}}
                                </div>
                                <div class="col-sm-4">
                                    {{> custToggle id="ringingInEars"
                                            label="Do you experience ringing or noises in your ears?"
                                            dataVal1="YES" choice1="YES"
                                            dataVal2="NO" choice2="NO"
                                            dataVal3="SOMETIMES" choice3="SOMETIMES"}}
                                </div>
                            </div>
                            <hr>
                            <div class="row">
                                <div class="col-sm-4">
                                    {{> custToggle id="oneEarBetter"
                                            label="Do you hear better with one ear than the other?"
                                            dataVal1="YES" choice1="YES"
