<div class="row">
    <div class="col-sm-12">
        <h1>Patient Registration Form for {{this.patient.firstname}} {{this.patient.lastname}}</h1>
        <form>
            <div class="panel-group" id="accordion" role="tablist" aria-multiselectable="true">
                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingOne">
                        <h4 class="panel-title">
                            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseOne"
                               aria-expanded="true" aria-controls="collapseOne">
                                Personal Information
                            </a>
                        </h4>
                    </div>
                    <div id="collapseOne" class="panel-collapse collapse in" role="tabpanel"
                         aria-labelledby="headingOne">
                        <div class="panel-body">
                            <div class="form-group">
                                <label for="lastname">Last name</label>
                                <input type="text" class="form-control" id="lastname" name="lastname"
                                       aria-describedby="lastname" placeholder="Last name">
                            </div>

                            <div class="form-group">
                                <label for="firstname">First name</label>
                                <input type="text" class="form-control" id="firstname" name="firstname"
                                       aria-describedby="firstname" placeholder="First name">
                            </div>

                            <div class="form-group">
                                <label for="middleinitial">Middle initial</label>
                                <input type="text" class="form-control" id="middleinitial" name="middleinitial"
                                       aria-describedby="middleinitial" placeholder="Middle initial">
                            </div>

                            <div class="form-group">
                                <label for="streetaddress">Street address</label>
                                <input type="text" class="form-control" id="streetaddress" name="streetaddress"
                                       aria-describedby="streetaddress" placeholder="3000 Sunny LN #1-B">
                            </div>

                            <div class="form-group">
                                <label for="city">City</label>
                                <input type="text" class="form-control" id="city" name="city" aria-describedby="city"
                                       placeholder="Atlanta">
                            </div>

                            <div class="form-group">
                                <label for="zipcode">ZIP Code</label>
                                <input type="text" class="form-control" id="zipcode" name="zipcode"
                                       aria-describedby="zipcode" placeholder="30675">
                            </div>

                            <div class="form-group">
                                <label for="homephone">Home phone</label>
                                <input type="tel" class="form-control" id="homephone" name="homephone"
                                       aria-describedby="homephone" placeholder="(***) *** - ****">
                            </div>

                            <div class="form-group">
                                <label for="cellphone">Cell phone</label>
                                <input type="tel" class="form-control" id="cellphone" name="cellphone"
                                       aria-describedby="cellphone" placeholder="(***) *** - ****">
                            </div>

                            <div class="form-group">
                                <label for="insuredbirthday">Date of birth</label>
                                <input type="tel" class="form-control" id="insuredbirthday" name="insuredbirthday"
                                       aria-describedby="insuredbirthday" placeholder="mm/dd/yyyy">
                            </div>

                            <div class="form-group">
                                <label for="ssn">SSN</label>
                                <input type="tel" class="form-control" id="ssn" name="ssn" aria-describedby="ssn"
                                       placeholder="*** - ** - ****">
                            </div>
                            <!--Sex-->
                            <fieldset class="form-group">
                                <label>Sex</label>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="radio" class="form-check-input" name="optionsRadios"
                                               id="optionsRadios1"
                                               value="option1" checked>
                                        Male
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="radio" class="form-check-input" name="optionsRadios"
                                               id="optionsRadios2"
                                               value="option2">
                                        Female
                                    </label>
                                </div>
                            </fieldset>
                            <!--Marital status-->
                            <fieldset class="form-group">
                                <label>Marital status</label>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="radio" class="form-check-input" name="optionsRadios"
                                               id="optionsRadios1"
                                               value="option1" checked>
                                        Single
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="radio" class="form-check-input" name="optionsRadios"
                                               id="optionsRadios2"
                                               value="option2">
                                        Married
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="radio" class="form-check-input" name="optionsRadios"
                                               id="optionsRadios3"
                                               value="option3">
                                        Other
                                    </label>
                                </div>
                            </fieldset>
                            <!--Employer info-->
                            <div class="form-group">
                                <label for="emplyername">Patient employer name</label>
                                <input type="text" class="form-control" id="emplyername" name="emplyername"
                                       aria-describedby="emplyername" placeholder="Employer name">
                            </div>

                            <div class="form-group">
                                <label for="employerstreetaddress">Street address</label>
                                <input type="text" class="form-control" id="employerstreetaddress"
                                       name="employerstreetaddress" aria-describedby="employerstreetaddress"
                                       placeholder="1234 Industrial Pkwy Suite 216">
                            </div>

                            <div class="form-group">
                                <label for="employercity">City</label>
                                <input type="text" class="form-control" id="employercity" name="employercity"
                                       aria-describedby="employercity" placeholder="Atlanta">
                            </div>

                            <div class="form-group">
                                <label for="employerzipcode">ZIP Code</label>
                                <input type="text" class="form-control" id="employerzipcode" name="employerzipcode"
                                       aria-describedby="employerzipcode" placeholder="30675">
                            </div>

                            <div class="form-group">
                                <label for="employerphone">Employer phone number</label>
                                <input type="tel" class="form-control" id="employerphone" name="employerphone"
                                       aria-describedby="employerphone" placeholder="(***) *** - ****">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingTwo">
                        <h4 class="panel-title">
                            <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion"
                               href="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                Insured/Responsible Party Information
                            </a>
                        </h4>
                    </div>
                    <div id="collapseTwo" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingTwo">
                        <div class="panel-body">
                            <fieldset class="form-group">
                                <label>Relationship to patient:</label>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="radio" class="form-check-input" name="optionsRadios"
                                               id="optionsRadios1"
                                               value="option1" checked>
                                        Spouse
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="radio" class="form-check-input" name="optionsRadios"
                                               id="optionsRadios2"
                                               value="option2">
                                        Parent
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="radio" class="form-check-input" name="optionsRadios"
                                               id="optionsRadios2"
                                               value="option2">
                                        Guardian
                                    </label>
                                </div>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="radio" class="form-check-input" name="optionsRadios"
                                               id="optionsRadios2"
                                               value="option2">
                                        None of the above
                                    </label>
                                </div>
                            </fieldset>
                            <div class="form-group">
                                <label for="lastname">Last name</label>
                                <input type="text" class="form-control" id="lastname" name="lastname"
                                       aria-describedby="lastname" placeholder="Last name">
                            </div>

                            <div class="form-group">
                                <label for="firstname">First name</label>
                                <input type="text" class="form-control" id="firstname" name="firstname"
                                       aria-describedby="firstname" placeholder="First name">
                            </div>

                            <div class="form-group">
                                <label for="middleinitial">Middle initial</label>
                                <input type="text" class="form-control" id="middleinitial" name="middleinitial"
                                       aria-describedby="middleinitial" placeholder="Middle initial">
                            </div>

                            <div class="form-group">
                                <label for="insuredstreetaddress">Street address (if different from above)</label>
                                <input type="text" class="form-control" id="insuredstreetaddress"
                                       name="insuredstreetaddress"
                                       aria-describedby="insuredstreetaddress" placeholder="3000 Sunny LN #1-B">
                            </div>

                            <div class="form-group">
                                <label for="insuredcity">City</label>
                                <input type="text" class="form-control" id="insuredcity" name="insuredcity"
                                       aria-describedby="insuredcity"
                                       placeholder="Atlanta">
                            </div>

                            <div class="form-group">
                                <label for="insuredzipcode">ZIP Code</label>
                                <input type="text" class="form-control" id="insuredzipcode" name="insuredzipcode"
                                       aria-describedby="insuredzipcode" placeholder="30675">
                            </div>

                            <div class="form-group">
                                <label for="insuredhomephone">Home phone</label>
                                <input type="tel" class="form-control" id="insuredhomephone" name="insuredhomephone"
                                       aria-describedby="insuredhomephone" placeholder="(***) *** - ****">
                            </div>

                            <div class="form-group">
                                <label for="insuredworkphone">Cell phone</label>
                                <input type="tel" class="form-control" id="insuredworkphone" name="insuredworkphone"
                                       aria-describedby="insuredworkphone" placeholder="(***) *** - ****">
                            </div>

                            <div class="form-group">
                                <label for="insuredssn">SSN</label>
                                <input type="tel" class="form-control" id="insuredssn" name="insuredssn"
                                       aria-describedby="insuredssn"
                                       placeholder="*** - ** - ****">
                            </div>

                            <div class="form-group">
                                <label for="insuredemplyername">Employer name</label>
                                <input type="text" class="form-control" id="insuredemplyername"
                                       name="insuredemplyername"
                                       aria-describedby="insuredemplyername" placeholder="Employer name">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingThree">
                        <h4 class="panel-title">
                            <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion"
                               href="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                Insurance Information
                            </a>
                        </h4>
                    </div>
                    <div id="collapseThree" class="panel-collapse collapse" role="tabpanel"
                         aria-labelledby="headingThree">
                        <div class="panel-body">
                            <!--Primary insurance-->
                            <div class="form-group">
                                <label for="primaryInsuranceName">Primary Insurance name</label>
                                <input type="text" class="form-control" id="primaryInsuranceName"
                                       name="primaryInsuranceName"
                                       aria-describedby="primaryInsuranceName" placeholder="Primary insurance name">
                            </div>

                            <div class="form-group">
                                <label for="insuranceStreetAddress">Street address</label>
                                <input type="text" class="form-control" id="insuranceStreetAddress"
                                       name="insuranceStreetAddress"
                                       aria-describedby="insuranceStreetAddress"
                                       placeholder="3000 Insurance Pkwy Ste.302">
                            </div>

                            <div class="form-group">
                                <label for="insuranceCity">City</label>
                                <input type="text" class="form-control" id="insuranceCity" name="insuranceCity"
                                       aria-describedby="insuranceCity"
                                       placeholder="Atlanta">
                            </div>

                            <div class="form-group">
                                <label for="insuranceZipCode">ZIP Code</label>
                                <input type="text" class="form-control" id="insuranceZipCode" name="insuranceZipCode"
                                       aria-describedby="insuranceZipCode" placeholder="30675">
                            </div>

                            <div class="form-group">
                                <label for="insurancePhone">Phone number</label>
                                <input type="tel" class="form-control" id="insurancePhone" name="insurancePhone"
                                       aria-describedby="insurancePhone" placeholder="(***) *** - ****">
                            </div>

                            <div class="form-group">
                                <label for="groupNumber">Group Number</label>
                                <input type="text" class="form-control" id="groupNumber" name="groupNumber"
                                       aria-describedby="groupNumber" placeholder="Insurance group number">
                            </div>

                            <div class="form-group">
                                <label for="idNumber">ID Number</label>
                                <input type="text" class="form-control" id="idNumber" name="idNumber"
                                       aria-describedby="idNumber" placeholder="Insurance ID number">
                            </div>

                            <div class="form-group">
                                <label for="employerName">Employer</label>
                                <input type="text" class="form-control" id="employerName" name="employerName"
                                       aria-describedby="employerName" placeholder="Employer name">
                            </div>

                            <div class="form-group">
                                <label for="employerTel">Employer Phone</label>
                                <input type="tel" class="form-control" id="employerTel" name="employerTel"
                                       aria-describedby="employerTel" placeholder="(***) *** - ****">
                            </div>

                            <hr>

                            <!--Secondary insurance-->
                            <div class="form-group">
                                <label for="secondaryInsuranceName">Secondary Insurance name</label>
                                <input type="text" class="form-control" id="secondaryInsuranceName"
                                       name="secondaryInsuranceName"
                                       aria-describedby="secondaryInsuranceName" placeholder="Secondary insurance name">
                            </div>

                            <div class="form-group">
                                <label for="secondaryInsStreetAddress">Street address</label>
                                <input type="text" class="form-control" id="secondaryInsStreetAddress"
                                       name="secondaryInsStreetAddress"
                                       aria-describedby="secondaryInsStreetAddress"
                                       placeholder="3000 Insurance Pkwy Ste.302">
                            </div>

                            <div class="form-group">
                                <label for="secondaryInsCity">City</label>
                                <input type="text" class="form-control" id="secondaryInsCity" name="secondaryInsCity"
                                       aria-describedby="secondaryInsCity"
                                       placeholder="Atlanta">
                            </div>

                            <div class="form-group">
                                <label for="secondaryInsZipCode">ZIP Code</label>
                                <input type="text" class="form-control" id="secondaryInsZipCode"
                                       name="secondaryInsZipCode"
                                       aria-describedby="secondaryInsZipCode" placeholder="30675">
                            </div>

                            <div class="form-group">
                                <label for="secondaryInsPhone">Phone number</label>
                                <input type="tel" class="form-control" id="secondaryInsPhone" name="secondaryInsPhone"
                                       aria-describedby="secondaryInsPhone" placeholder="(***) *** - ****">
                            </div>

                            <div class="form-group">
                                <label for="secondaryInsGroupNumber">Group Number</label>
                                <input type="text" class="form-control" id="secondaryInsGroupNumber"
                                       name="secondaryInsGroupNumber"
                                       aria-describedby="secondaryInsGroupNumber"
                                       placeholder="Secondary Insurance group number">
                            </div>

                            <div class="form-group">
                                <label for="secondaryInsIDNumber">ID Number</label>
                                <input type="text" class="form-control" id="secondaryInsIDNumber"
                                       name="secondaryInsIDNumber"
                                       aria-describedby="secondaryInsIDNumber"
                                       placeholder="Secondary Insurance ID number">
                            </div>

                            <div class="form-group">
                                <label for="secondaryEmployerName">Employer</label>
                                <input type="text" class="form-control" id="secondaryEmployerName"
                                       name="secondaryEmployerName"
                                       aria-describedby="secondaryEmployerName" placeholder="Employer name">
                            </div>

                            <div class="form-group">
                                <label for="secondaryEmployerTel">Employer Phone</label>
                                <input type="tel" class="form-control" id="secondaryEmployerTel"
                                       name="secondaryEmployerTel"
                                       aria-describedby="secondaryEmployerTel" placeholder="(***) *** - ****">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingFour">
                        <h4 class="panel-title">
                            <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion"
                               href="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                                Additional Information
                            </a>
                        </h4>
                    </div>
                    <div id="collapseFour" class="panel-collapse collapse" role="tabpanel"
                         aria-labelledby="headingFour">
                        <div class="panel-body">
                            <div class="form-group">
                                <label for="primaryDoctor">Primary / Family Doctor</label>
                                <input type="text" class="form-control" id="primaryDoctor" name="primaryDoctor"
                                       aria-describedby="primaryDoctor" placeholder="Primary / Family Doctor">
                            </div>

                            <div class="form-group">
                                <label for="refferingDoctor">Reffering Doctor</label>
                                <input type="text" class="form-control" id="refferingDoctor" name="refferingDoctor"
                                       aria-describedby="refferingDoctor" placeholder="Reffering Doctor">
                            </div>

                            <div class="form-group">
                                <label for="emergencyContact">Emergency Contact</label>
                                <input type="text" class="form-control" id="emergencyContact" name="emergencyContact"
                                       aria-describedby="emergencyContact" placeholder="Emergency Contact">
                            </div>

                            <div class="form-group">
                                <label for="relationship">Relationship to Patient</label>
                                <input type="text" class="form-control" id="relationship" name="relationship"
                                       aria-describedby="relationship" placeholder="Relationship to patient">
                            </div>

                            <div class="form-group">
                                <label for="emergencyContactTel">Phone Number</label>
                                <input type="tel" class="form-control" id="emergencyContactTel"
                                       name="emergencyContactTel"
                                       aria-describedby="emergencyContactTel" placeholder="(***) *** - ****">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingFive">
                        <h4 class="panel-title">
                            <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion"
                               href="#collapseFive" aria-expanded="false" aria-controls="collapseFive">
                                Release of Information Consent
                            </a>
                        </h4>
                    </div>
                    <div id="collapseFive" class="panel-collapse collapse" role="tabpanel"
                         aria-labelledby="headingFive">
                        <div class="panel-body">
                            <div>
                                <p>I understand that:</p>
                                <ul>
                                    <li>Once "<u>this facility</u>" discloses my health information by my request, it
                                        can not guarantee that Recipient will not re-disclose my health information to a
                                        third party. The third party may not be required to abide by the Authorization
                                        or applicable federal and state laws governing the use and disclosure of my
                                        health information.
                                    </li>
                                    <li>I may make a request in writing at any time to inspect and/or obtain a copy of
                                        my health information maintained at this facility as provided in the Federal
                                        Privacy Rule 45 CFR (164.524).
                                    </li>
                                    <li>My records are protected and cannot be disclosed without written permission.
                                    </li>
                                    <li>This Authorization will remain in effect for one year or until I provide a
                                        written notice of revocation to the Medical Record Department.
                                    </li>
                                </ul>
                            </div>
                            <div class="form-group">
                                <label for="signature">Signature</label>
                                <input type="text" class="form-control" id="signature" name="signature"
                                       aria-describedby="signature" placeholder="SIGNATURE">
                            </div>

                            <div class="form-group">
                                <label for="date">Date</label>
                                <input type="datetime" class="form-control" id="date" name="date"
                                       aria-describedby="date" placeholder="DATE">
                            </div>

                            <div class="form-group">
                                <label for="email">Email</label>
                                <input type="email" class="form-control" id="email" name="email"
                                       aria-describedby="email" placeholder="username@email.com">
                            </div>

                            <div class="form-group">
                                <label for="consentRelationship">If signed by legal representative &mdash; Relationship
                                    to patient</label>
                                <input type="text" class="form-control" id="consentRelationship"
                                       name="consentRelationship"
                                       aria-describedby="consentRelationship" placeholder="Relationship to patient">
                            </div>

                            <div class="form-group">
                                <label for="witnessSignature">Signature of Witness (Optional)</label>
                                <input type="text" class="form-control" id="witnessSignature"
                                       name="witnessSignature"
                                       aria-describedby="witnessSignature" placeholder="Signature of Witness">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <hr>
            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>
</div>

