{{#if isAuthenticated}}
    <div class="row">
        <div class="col-lg-12">
            <h1>Appointments for {{today}}</h1>
        </div>
        <div class="col-lg-12">
            <div class="table-responsive">
                <table class="table appointments">
                    <thead>
                    <tr>
                        <th>&nbsp;</th>
                        <th>Last Name</th>
                        <th>First Name</th>
                        <th>Appt. Time</th>
                        <th>Appt.Type</th>
                        <th>Provider</th>
                        <th>&nbsp;</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#each appts}}
                        <tr class="apptRow" data-appt-id="{{this.appointmentid}}" data-patient-id="{{this.patient.patientid}}">
                            <td><i class="glyphicon glyphicon-user"></i></td>
                            <td>{{this.patient.lastname}}</td>
                            <td>{{this.patient.firstname}}</td>
                            <td>{{this.starttime}}</td>
                            <td>{{this.appointmenttype}}</td>
                            <td>{{{providerName ../this.providers}}}</td>
                            <td>
                                <a href="#" class="btn btn-small btn-primary start-check-in"
                                   data-apptid="{{this.appointmentid}}" data-patientid="{{this.patient.patientid}}">Start Check-in</a>
                            </td>
                        </tr>
                    {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!--Load custom scripts - template specific-->
    <!--http://stackoverflow.com/questions/25300017/how-to-ensure-the-javascript-is-at-the-bottom-of-the-code-in-express-handlebars-->
    <!--http://stackoverflow.com/questions/34628978/register-custom-helper-express-and-hbs-->
    {{#section 'script'}}
        <script src="/javascripts/index.js"></script>
    {{/section}}
    {{#section 'style'}}
        <link rel='stylesheet' href='/stylesheets/appointments.css'/>
    {{/section}}

    <!-- Modal -->
    <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Check-In Started!</h4>
            </div>
            <div class="modal-body">
                <p>This patient check-in process has already started.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary">Start Over</button>
            </div>
        </div>
    </div>
</div>
{{else}}
    <div class="row">
        <div class="col-sm-12 logIn">
            <h1>Welcome to Patient CheckIn!</h1>

            <div class="row">
                <div class="col-md-8">
                    <p>With the help of this app patients can now complete the intake forms before their appointments.
                        Best of all, there’s no need to manually enter the form’s responses into your Athena
                        EHR &mdash; the information will flow directly into the patient’s chart note.</p>
                    <ul>
                        <li>
                            <b>Create completely customizable intake forms</b>
                            The intake forms for Online Check-In are easy to create and 100% customizable for your practice. You can completely replicate your current patient intake forms, plus you can update a form at any time.
                        </li>
                        <li>
                            <b>Get more complete forms</b>
                            It can be easy for patients to forget important details when they’re filling out forms in the waiting room. Now patients can complete your forms at a convenient time when they have access to all their medical information.
                        </li>
                        <li>
                            <b>Save time for your patients and staff</b>
                            Your patients save time by not having to complete paper forms in the office, and your staff saves time by not having to scan or enter the form’s information into your EHR.
                        </li>
                    </ul>
                    <br>
                </div>
                <div class="col-md-4">
                    <!-- show any messages that come back with authentication -->
                    {{#if message}}
                        <div class="alert alert-danger">{{message}}</div>
                    {{/if}}

                    <form class="form logInForm" action="/users/login" method="post">
                        <div class="form-group">
                            <label class="sr-only" for="email">Email address</label>
                            <input type="email" class="form-control" name="email" id="email" placeholder="Email">
                        </div>
                        <div class="form-group">
                            <label class="sr-only" for="password">Password</label>
                            <input type="password" class="form-control" name="password" id="password" placeholder="Password">
                        </div>
                        <button type="submit" class="btn btn-default btn-primary">Sign in</button>
                    </form>
                    <p class="lead">
                        For Demo please use the following credentials:
                    </p>
                    <ul>
                        <li>User: stevo@test.com</li>
                        <li>Pass: l02ink@</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
{{/if}}