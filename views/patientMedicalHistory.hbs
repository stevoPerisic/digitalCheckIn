<!--
Health History forms docs
https://developer.athenahealth.com/docs/read/workflows/Health_History_Forms
-->
<div class="row">
    <div class="col-sm-12">
        <h1>Patient Medical History</h1>
        <form>
            <div class="panel-group" id="accordion" role="tablist" aria-multiselectable="true">
                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingOne">
                        <h4 class="panel-title">
                            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseOne"
                               aria-expanded="true" aria-controls="collapseOne">
                                Personal Information
                            </a>
                        </h4>
                    </div>
                    <div id="collapseOne" class="panel-collapse collapse in" role="tabpanel"
                         aria-labelledby="headingOne">
                        <div class="panel-body">
                            <!--Personal info-->
                            <div class="form-group row">
                                <div class="col-sm-4">
                                    {{#if this.patient.lastname}}
                                        {{> patientDataFilled label="Last Name" text=this.patient.lastname show=true}}
                                    {{/if}}
                                    {{> custInputFld type="text" id="lastname" label="Last Name" placeholder="Last name"}}
                                </div>
                                <div class="col-sm-4">
                                    {{#if this.patient.middlename}}
                                        {{> patientDataFilled label="Middle initial" text=this.patient.lastname show=true}}
                                    {{/if}}
                                    {{> custInputFld type="text" id="middlename" label="Middle initial" placeholder="Middle initial"}}
                                </div>
                                <div class="col-sm-4">
                                    {{#if this.patient.firstname}}
                                        {{> patientDataFilled label="First Name" text=this.patient.firstname show=true}}
                                    {{/if}}
                                    {{> custInputFld type="text" id="firstname" label="First name" placeholder="First name"}}
                                </div>
                            </div>
                            <!--Pharmacy-->
                            <div class="form-group row">
                                <div class="col-lg-12">
                                    {{#if this.patient.defaultpharmacyncpdpid}}
                                        {{> patientDataFilled label="Preferred Pharmacy" text=this.patient.defaultpharmacyncpdpid show=true}}
                                    {{/if}}
                                    {{> custInputFld type="text" id="defaultpharmacyncpdpid" label="Preferred Pharmacy" placeholder="Preferred Pharmacy"}}
                                </div>
                            </div>
                            <!--Allergies-->
                            <div class="form-group row">
                                <div class="col-lg-12">
                                    <fieldset class="form-group">
                                        <legend>Allergies</legend>
                                        <div class="row">
                                            <div class="col-md-3 col-sm-6">
                                                {{> custChkBx text="NONE / No Known allergies"}}

                                                {{> custChkBx text="Adhesive Tape"}}

                                                {{> custChkBx text="Anesthesia"}}
                                            </div>
                                            <div class="col-md-3 col-sm-6">
                                                {{> custChkBx text="Aspirin" allergies=allergies}}

                                                {{> custChkBx text="Codeine"}}

                                                {{> custChkBx text="Dairy Products"}}
                                            </div>
                                            <div class="col-md-3 col-sm-6">
                                                {{> custChkBx text="Iodine / Shellfish / Contrast Dye"}}

                                                {{> custChkBx text="Latex"}}

                                                {{> custChkBx text="Morphine"}}
                                            </div>
                                            <div class="col-md-3 col-sm-6">
                                                {{> custChkBx text="Penicillin"}}

                                                {{> custChkBx text="Sulfa drugs"}}

                                                {{> custChkBx text="Wheat"}}
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                            {{> accBtnNext text="Next"}}
                        </div>
                    </div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingTwo">
                        <h4 class="panel-title">
                            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo"
                               aria-expanded="true" aria-controls="collapseTwo">
                                Family History
                            </a>
                        </h4>
                    </div>
                    <div id="collapseTwo" class="panel-collapse collapse" role="tabpanel"
                         aria-labelledby="headingTwo">
                        <div class="panel-body">
                            <div class="form-group row">
                                <div class="col-lg-12">
                                    <fieldset>
                                        <legend>
                                            Please indicate if any of your immediate relatives have had any of the
                                            following by selecting the appropriate check-box.
                                        </legend>
                                        <ul>
                                            {{#each familyHistory}}
                                                <li>
                                                    {{relation}}
                                                    <ul>
                                                        {{#each this.problems}}
                                                        <li>{{description}}</li>
                                                        {{/each}}
                                                    </ul>
                                                </li>
                                            {{/each}}
                                        </ul>
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                <tr>
                                                    <th>Issue</th>
                                                    <th>Mother</th>
                                                    <th>Father</th>
                                                    <th>Sibling (sister/brother)</th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                <tr>
                                                    <td>Anesthesia Problems</td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Arthritis</td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Cancer</td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Diabetes</td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Heart Problems</td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Hypertension</td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Stroke</td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Thyroid Disorder</td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text=""}}
                                                    </td>
                                                </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                            {{> accBtnNext text="Next"}}
                        </div>
                    </div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingThree">
                        <h4 class="panel-title">
                            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseThree"
                               aria-expanded="true" aria-controls="collapseThree">
                                Social History
                            </a>
                        </h4>
                    </div>
                    <div id="collapseThree" class="panel-collapse collapse" role="tabpanel"
                         aria-labelledby="headingThree">
                        <div class="panel-body">
                            <div class="form-group row">
                                <div class="col-md-3 col-sm-6">
                                    {{#parseJSON    '[{"value": "Single", "text": "Single"},
                                                    {"value": "Married", "text": "Married"},
                                                    {"value": "Divorced", "text": "Widowed"},
                                                    {"value": "Separated", "text": "Separated"}]'}}
                                        {{> custSelect id="maritalStatus" label="Marital status" emptyOption=true options=this }}
                                    {{/parseJSON}}
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <fieldset>
                                        <div class="form-group">
                                            <label for="occupation">Occupation</label>
                                            <input type="text" class="form-control" id="occupation" name="occupation"
                                                   aria-describedby="occupation" placeholder="Occupation">
                                        </div>

                                        {{> custChkBx text="Retired?"}}

                                        {{> custChkBx text="Disabled?"}}

                                        <div class="form-group">
                                            <label for="disabilityReason">Disability Reason</label>
                                            <input type="text" class="form-control" id="disabilityReason"
                                                   name="disabilityReason"
                                                   aria-describedby="disabilityReason" placeholder="Disability Reason">
                                        </div>
                                    </fieldset>
                                </div>
                                <div class="col-md-3 col-sm-6">

                                    <!--
                                        custom choice inputs via https://bootsnipp.com/snippets/NBN6x
                                    -->
                                    <div class="input-group" style="width: 100%;">
                                        <label for="drinkAlcohol">Do you drink alcohol?</label>
                                        <br>
                                        <div class="radioBtn btn-group" style="width: 100%;">
                                            <span style="width: 50%;" class="btn btn-primary active" data-toggle="drinkAlcohol" data-value="Yes">Yes</span>
                                            <span style="width: 50%;" class="btn btn-default notActive" data-toggle="drinkAlcohol" data-value="No">No</span>
                                        </div>
                                        <input type="hidden" name="drinkAlcohol" id="drinkAlcohol">
                                    </div>
                                    <br>

                                    {{#parseJSON    '[{"value": "Daily", "text": "Daily"},
                                                    {"value": "Weekly", "text": "Weekly"},
                                                    {"value": "Infrequently", "text": "Infrequently"},
                                                    {"value": "Recovering Alcoholic", "text": "Recovering Alcoholic"}]'}}
                                        {{> custSelect id="alcoholFrequency" label="How often?" emptyOption=true options=this }}
                                    {{/parseJSON}}
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <!--
                                        custom choice inputs via https://bootsnipp.com/snippets/NBN6x
                                    -->
                                    <div class="input-group" style="width: 100%;">
                                        <label for="useTobacco">Do you use tobacco?</label>
                                        <br>
                                        <div class="radioBtn btn-group" style="width: 100%;">
                                            <span style="width: 50%;" class="btn btn-primary active" data-toggle="useTobacco" data-value="Yes">Yes</span>
                                            <span style="width: 50%;" class="btn btn-default notActive" data-toggle="useTobacco" data-value="No">No</span>
                                        </div>
                                        <input type="hidden" name="useTobacco" id="useTobacco">
                                    </div>
                                    <br>

                                    <!--
                                        custom choice inputs via https://bootsnipp.com/snippets/NBN6x
                                    -->
                                    <div class="input-group" style="width: 100%;">
                                        <label for="useTobaccoWay">Preferred way of use?</label>
                                        <br>
                                        <div class="radioBtn btn-group" style="width: 100%;">
                                            <span style="width: 50%;" class="btn btn-primary active" data-toggle="useTobaccoWay" data-value="Yes">Smoke</span>
                                            <span style="width: 50%;" class="btn btn-default notActive" data-toggle="useTobaccoWay" data-value="No">Chew</span>
                                        </div>
                                        <input type="hidden" name="useTobaccoWay" id="useTobaccoWay">
                                    </div>
                                    <br>

                                    <div class="form-group">
                                        <label for="cigPacksPerDay">Packs a day?</label>
                                        <input type="number" class="form-control" id="cigPacksPerDay"
                                               name="cigPacksPerDay"
                                               aria-describedby="cigPacksPerDay" placeholder="0">
                                    </div>
                                </div>
                            </div>
                            {{> accBtnNext text="Next"}}
                        </div>
                    </div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingFour">
                        <h4 class="panel-title">
                            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseFour"
                               aria-expanded="true" aria-controls="collapseFour">
                                Surgical History
                            </a>
                        </h4>
                    </div>
                    <div id="collapseFour" class="panel-collapse collapse" role="tabpanel"
                         aria-labelledby="headingFour">
                        <div class="panel-body">
                            <fieldset>
                                <legend>Please list any <strong>hospitalizations</strong>, <strong>surgeries</strong>,
                                    <strong>fractures</strong> or <strong>major illnesses</strong> you have had.
                                </legend>
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                        <tr>
                                            <th>TYPE OF SURGERY</th>
                                            <th>YEAR or DATE</th>
                                            <th>DOCTOR</th>
                                            <th>LOCATION</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <tr class="tableFormInputs">
                                            <td>
                                                <div class="form-group">
                                                    <label for="typeOfSurgery" class="sr-only"></label>
                                                    <input id="typeOfSurgery" name="typeOfSurgery" type="text" class="form-control">
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-group">
                                                    <label for="surgeryDate" class="sr-only"></label>
                                                    <input id="surgeryDate" name="surgeryDate" type="text" class="form-control">
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-group">
                                                    <label for="surgeryDoctor" class="sr-only"></label>
                                                    <input id="surgeryDoctor" name="surgeryDoctor" type="text" class="form-control">
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-group">
                                                    <label for="surgeryLocation" class="sr-only"></label>
                                                    <input id="surgeryLocation" name="surgeryLocation" type="text" class="form-control">
                                                </div>
                                            </td>
                                        </tr>
                                        </tbody>
                                        <tfoot>
                                        <tr>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td style="text-align: left;">
                                                <input type="button" class="btn btn-primary btn-block addrow"
                                                       value="Add Row"/>
                                            </td>
                                        </tr>
                                        <tr>
                                        </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </fieldset>
                            {{> accBtnNext text="Next"}}
                        </div>
                    </div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingFive">
                        <h4 class="panel-title">
                            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseFive"
                               aria-expanded="true" aria-controls="collapseFive">
                                Medical History
                            </a>
                        </h4>
                    </div>
                    <div id="collapseFive" class="panel-collapse collapse" role="tabpanel"
                         aria-labelledby="headingFive">
                        <div class="panel-body">
                            <fieldset>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <legend>Have you ever had any of the following?</legend>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-3 col-sm-6">
                                        {{> custChkBx text="None of the problems listed"}}

                                        {{> custChkBx text="Allergies"}}

                                        {{> custChkBx text="Anemia"}}

                                        {{> custChkBx text="Anemia"}}

                                        {{> custChkBx text="Asthma"}}

                                        {{> custChkBx text="Arterial Fibrilation"}}

                                        {{> custChkBx text="Bleeding problems"}}

                                        {{> custChkBx text="BPH"}}

                                        {{> custChkBx text="Coronary Artery Disease (CAD)"}}

                                        {{> custChkBx text="Cancer"}}

                                        {{> custChkBx text="Cardiac Arrest"}}

                                        {{> custChkBx text="Celiac Disease"}}
                                    </div>
                                    <div class="col-md-3 col-sm-6">

                                        {{> custChkBx text="Chest Pain"}}

                                        {{> custChkBx text="Congestive Heart Failure (CHF)"}}

                                        {{> custChkBx text="Chronic Fatigue Syndrome"}}

                                        {{> custChkBx text="Depression"}}

                                        {{> custChkBx text="Diabetes"}}

                                        {{> custChkBx text="Drug/Alcohol Abuse"}}

                                        {{> custChkBx text="Erectile dysfunction"}}

                                        {{> custChkBx text="Fibromyalgia"}}

                                        {{> custChkBx text="Gerd"}}

                                        {{> custChkBx text="Heart Desease"}}

                                        {{> custChkBx text="High Cholesterol"}}

                                        {{> custChkBx text="Hyperinsulinemia"}}
                                    </div>
                                    <div class="col-md-3 col-sm-6">
                                        {{> custChkBx text="Hyperlipidemia"}}

                                        {{> custChkBx text="Hypertension"}}

                                        {{> custChkBx text="Hypogonadism (male)"}}

                                        {{> custChkBx text="Hypothyroidism"}}

                                        {{> custChkBx text="Infection problems"}}

                                        {{> custChkBx text="Insomnia"}}

                                        {{> custChkBx text="Irritable Bowel Syndrome"}}

                                        {{> custChkBx text="Kidney problems"}}

                                        {{> custChkBx text="Menopause"}}

                                        {{> custChkBx text="Migraines/Headaches"}}

                                        {{> custChkBx text="Neuropathy"}}

                                        {{> custChkBx text="Onychomicosis"}}
                                    </div>
                                    <div class="col-md-3 col-sm-6">
                                        {{> custChkBx text="Organ Injury"}}

                                        {{> custChkBx text="Osteoporosis"}}

                                        {{> custChkBx text="Pulmonary embolism/blood clot in legs"}}

                                        {{> custChkBx text="Seizure disorders"}}

                                        {{> custChkBx text="Shortness of breath"}}

                                        {{> custChkBx text="Sinus conditions"}}

                                        {{> custChkBx text="Stroke"}}

                                        {{> custChkBx text="Syndrome X"}}

                                        {{> custChkBx text="Tremors"}}

                                        {{> custChkBx text="Wheat allergy"}}

                                    </div>
                                </div>
                            </fieldset>
                            {{> accBtnNext text="Next"}}
                        </div>
                    </div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingSix">
                        <h4 class="panel-title">
                            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseSix"
                               aria-expanded="true" aria-controls="collapseSix">
                                Medications
                            </a>
                        </h4>
                    </div>
                    <div id="collapseSix" class="panel-collapse collapse" role="tabpanel"
                         aria-labelledby="headingSix">
                        <div class="panel-body">
                            <fieldset>
                                <legend>
                                    List any medications you are currently taking (please include over the counter medications).
                                </legend>
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                        <tr>
                                            <th>MEDICATION</th>
                                            <th>DOSAGE</th>
                                            <th>PRESCRIBING DOCTOR</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <tr class="tableFormInputs">
                                            <td>
                                                <div class="form-group">
                                                    <label for="currMeds" class="sr-only"></label>
                                                    <input id="currMeds" name="currMeds" type="text" class="form-control">
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-group">
                                                    <label for="currMedsDosage" class="sr-only"></label>
                                                    <input id="currMedsDosage" name="currMedsDosage" type="text" class="form-control">
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-group">
                                                    <label for="currMedsDoc" class="sr-only"></label>
                                                    <input id="currMedsDoc" name="currMedsDoc" type="text" class="form-control">
                                                </div>
                                            </td>
                                        </tr>
                                        </tbody>
                                        <tfoot>
                                        <tr>
                                            <td></td>
                                            <td></td>
                                            <td style="text-align: left;">
                                                <input type="button" class="btn btn-primary btn-block addrow" value="Add Row"/>
                                            </td>
                                        </tr>
                                        <tr>
                                        </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>
            </div>

            <hr>
            <button type="submit" class="btn btn-primary btn-lg submit">Submit</button>
        </form>
    </div>
</div>

<!--Load custom scripts - template specific-->
<!--http://stackoverflow.com/questions/25300017/how-to-ensure-the-javascript-is-at-the-bottom-of-the-code-in-express-handlebars-->
<!--http://stackoverflow.com/questions/34628978/register-custom-helper-express-and-hbs-->
{{#section 'script'}}
    <script src="/javascripts/patientMedicalHistoryForm.js"></script>
{{/section}}
{{#section 'style'}}
    <link rel='stylesheet' href='/stylesheets/patientMedicalHistoryForm.css'/>
{{/section}}