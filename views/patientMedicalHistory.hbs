<!--
Health History forms docs
https://developer.athenahealth.com/docs/read/workflows/Health_History_Forms
-->
<div class="row">
    <div class="col-sm-12">
        <h1>Patient Medical History</h1>

        <div class="panel-group" id="accordion" role="tablist" aria-multiselectable="true">
            <div class="panel panel-default">
                <div class="panel-heading" role="tab" id="headingOne">
                    <h4 class="panel-title">
                        <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseOne"
                           aria-expanded="true" aria-controls="collapseOne">
                            Personal Information
                        </a>
                    </h4>
                </div>
                <div id="collapseOne" class="panel-collapse collapse in" role="tabpanel"
                     aria-labelledby="headingOne">
                    <div class="panel-body">
                        <form action="" id="personalInformationForm" data-url="/patientMedicalHistory/personalInfo">
                            <!--Personal info-->
                            <div class="form-group row">
                                <div class="col-sm-4">
                                    {{#longerThanZero this.patient.lastname}}
                                        {{> patientDataFilled label="Last Name" text=this.patient.lastname show=true}}
                                    {{/longerThanZero}}
                                    {{> custInputFld type="text" id="lastname" label="Last Name" placeholder="Last name"}}
                                </div>
                                <div class="col-sm-4">
                                    {{#longerThanZero this.patient.middlename}}
                                        {{> patientDataFilled label="Middle name" text=this.patient.middlename show=true}}
                                    {{/longerThanZero}}
                                    {{> custInputFld type="text" id="middlename" label="Middle name" placeholder="Middle name"}}
                                </div>
                                <div class="col-sm-4">
                                    {{#longerThanZero this.patient.firstname}}
                                        {{> patientDataFilled label="First Name" text=this.patient.firstname show=true}}
                                    {{/longerThanZero}}
                                    {{> custInputFld type="text" id="firstname" label="First name" placeholder="First name"}}
                                </div>
                            </div>
                            <!--Pharmacy-->
                            <div class="form-group row">
                                <div class="col-sm-10">
                                    {{#longerThanZero this.preferredPharmacy.clinicalprovidername}}
                                        {{> patientDataFilled label="Preferred Pharmacy" text=this.preferredPharmacy.clinicalprovidername show=true}}
                                    {{/longerThanZero}}
                                    {{> custInputFld type="text" id="preferredpharmacyncpdpid" label="Preferred Pharmacy" placeholder="Enter pharmacy name and press Search..."}}
                                </div>
                                <div class="col-sm-10">
                                    {{#longerThanZero this.defaultPharmacy.clinicalprovidername}}
                                        {{> patientDataFilled label="Default Pharmacy" text=this.defaultPharmacy.clinicalprovidername show=true}}
                                    {{/longerThanZero}}
                                    {{> custInputFld type="text" id="defaultpharmacyncpdpid" label="Default Pharmacy" placeholder="Enter pharmacy name and press Search..."}}
                                </div>
                                <div class="col-sm-2 pharmacySearch">
                                    <a href="#" class="btn btn-primary btn-small findPharmacy">Search</a>
                                </div>
                            </div>
                            <div class="row mapWrapper">
                                <div class="mapLoaderOverlay">
                                    <div class="loader">Loading...</div>
                                </div>
                                <div class="col-sm-12">
                                    <p>Select a pharmacy that is most convenient for you below.</p>
                                </div>
                                <div class="col-sm-4 pharmacyResultWrapper">
                                    <div id="pharmacyResults"></div>
                                </div>
                                <div class="col-sm-8">
                                    <div id="map"></div>
                                </div>
                            </div>
                            <!--Allergies-->
                            <div class="form-group row">
                                <div class="col-lg-12">
                                    <fieldset class="form-group">
                                        <legend>Allergies</legend>
                                        <div class="row">
                                            <div class="col-md-3 col-sm-6">
                                                {{> custChkBx text="NONE / No known allergies" dataType="allergies"}}

                                                {{> custChkBx text="Adhesive Tape" dataType="allergies"}}

                                                {{> custChkBx text="Anesthesia" dataType="allergies"}}
                                            </div>
                                            <div class="col-md-3 col-sm-6">
                                                {{> custChkBx text="Aspirin" dataType="allergies"}}

                                                {{> custChkBx text="Codeine" dataType="allergies"}}

                                                {{> custChkBx text="Dairy Products" dataType="allergies"}}
                                            </div>
                                            <div class="col-md-3 col-sm-6">
                                                {{> custChkBx text="Iodine / Shellfish / Contrast Dye" dataType="allergies"}}

                                                {{> custChkBx text="Latex" dataType="allergies"}}

                                                {{> custChkBx text="Morphine" dataType="allergies"}}
                                            </div>
                                            <div class="col-md-3 col-sm-6">
                                                {{> custChkBx text="Penicillin" dataType="allergies"}}

                                                {{> custChkBx text="Sulfa drugs" dataType="allergies"}}

                                                {{> custChkBx text="Wheat" dataType="allergies"}}
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-sm-12">
                                                <p>Is your allergy not listed? Enter it below:</p>
                                                {{> custListInput inputId="customAllergies" listClass="customAllergiesList"
                                                        label="Allergy name" placeholder="Allergy description" btnLabel="Add Allergy"}}
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                            {{> accBtnNext text="Next" submit=true}}
                        </form>
                    </div>
                </div>
            </div>
            <!-- Family History -->
            <div class="panel panel-default">
                <div class="panel-heading" role="tab" id="headingTwo">
                    <h4 class="panel-title">
                        <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo"
                           aria-expanded="true" aria-controls="collapseTwo">
                            Family History
                        </a>
                    </h4>
                </div>
                <div id="collapseTwo" class="panel-collapse collapse" role="tabpanel"
                     aria-labelledby="headingTwo">
                    <div class="panel-body">
                        <form action="" id="familyHistory" data-url="/patientMedicalHistory/familyHistory">
                            <div class="form-group row">
                                <div class="col-lg-12">
                                    <fieldset>
                                        <legend>
                                            Please indicate if any of your immediate relatives have had any of the
                                            following by selecting the appropriate check-box.
                                        </legend>
                                        <ul>
                                            {{#each familyHistory}}
                                                <li>
                                                    {{relation}}
                                                    <ul>
                                                        {{#each this.problems}}
                                                            <li>{{description}}</li>
                                                        {{/each}}
                                                    </ul>
                                                </li>
                                            {{/each}}
                                        </ul>
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                <tr>
                                                    <th>Issue</th>
                                                    <th>Mother</th>
                                                    <th>Father</th>
                                                    <th>Sibling (sister/brother)</th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                <tr>
                                                    <td>Anesthesia Problems</td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Anesthesia" dataRel="Mother" dataType="relatives"}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Anesthesia" dataRel="Father" dataType="relatives"}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Anesthesia" dataRel="Sibling" dataType="relatives"}}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Arthritis</td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Arthritis" dataRel="Mother" dataType="relatives"}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Arthritis" dataRel="Father" dataType="relatives"}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Arthritis" dataRel="Sibling" dataType="relatives"}}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Cancer</td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Cancer" dataRel="Mother" dataType="relatives"}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Cancer" dataRel="Father" dataType="relatives"}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Cancer" dataRel="Sibling" dataType="relatives"}}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Diabetes</td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Diabetes" dataRel="Mother" dataType="relatives"}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Diabetes" dataRel="Father" dataType="relatives"}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Diabetes" dataRel="Sibling" dataType="relatives"}}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Heart Problems</td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Heart Problems" dataRel="Mother" dataType="relatives"}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Heart Problems" dataRel="Father" dataType="relatives"}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Heart Problems" dataRel="Sibling" dataType="relatives"}}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Hypertension</td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Hypertension" dataRel="Mother" dataType="relatives"}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Hypertension" dataRel="Father" dataType="relatives"}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Hypertension" dataRel="Sibling" dataType="relatives"}}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Stroke</td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Stroke" dataRel="Mother" dataType="relatives"}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Stroke" dataRel="Father" dataType="relatives"}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Stroke" dataRel="Sibling" dataType="relatives"}}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Thyroid Disorder</td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Thyroid Disorder" dataRel="Mother" dataType="relatives"}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Thyroid Disorder" dataRel="Father" dataType="relatives"}}
                                                    </td>
                                                    <td>
                                                        {{> custChkBx text="" dataValue="Thyroid Disorder" dataRel="Sibling" dataType="relatives"}}
                                                    </td>
                                                </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                            {{> accBtnNext text="Next" submit=true}}
                        </form>
                    </div>
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading" role="tab" id="headingThree">
                    <h4 class="panel-title">
                        <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseThree"
                           aria-expanded="true" aria-controls="collapseThree">
                            Social History
                        </a>
                    </h4>
                </div>
                <div id="collapseThree" class="panel-collapse collapse" role="tabpanel"
                     aria-labelledby="headingThree">
                    <div class="panel-body">
                        <form action="" id="socialHistroy" data-url="/patientMedicalHistory/socialHistory">
                            <div class="row">
                                <ul>
                                    {{#each socialHistory}}
                                        <li>
                                            Q: {{question}} <br>
                                            A: {{answer}} <br>
                                            Q-key: {{key}}
                                        </li>
                                    {{/each}}
                                </ul>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3 col-sm-6">
                                    {{#parseJSON maritalStatusSelect}}
                                        {{> custSelect id="maritalstatus" label="Marital status" emptyOption=true options=this selected=this.patient.maritalstatus }}
                                    {{/parseJSON}}
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <fieldset>
                                        <!--
                                        @todo finish this below
                                        - SNOMED codes https://uts.nlm.nih.gov//snomedctBrowser.html#3723001;0;0;CONCEPT_ID;null;SNOMEDCT_US;null;true;
                                        -->
                                        {{#longerThanZero this.preferredPharmacy.clinicalprovidername}}
                                            {{> patientDataFilled label="Occupation" show=true}}
                                        {{/longerThanZero}}
                                        {{> custInputFld type="text" id="occupation" label="Occupation" placeholder="Occupation"}}

                                        <div class="form-group">
                                            <label for="occupation">Occupation</label>
                                            <input type="text" class="form-control" id="occupation" name="occupation"
                                                   aria-describedby="occupation" placeholder="Occupation">
                                        </div>

                                        {{> custChkBx text="Retired?"}}

                                        {{> custChkBx text="Disabled?"}}

                                        <div class="form-group">
                                            <label for="disabilityReason">Disability Reason</label>
                                            <input type="text" class="form-control" id="disabilityReason"
                                                   name="disabilityReason"
                                                   aria-describedby="disabilityReason" placeholder="Disability Reason">
                                        </div>
                                    </fieldset>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <!--@todo Fix the dataSelected to come from the socialHistory data set-->
                                    {{> custToggle id="drinkAlcohol" label="Do you drink alcohol?" dataSelected="Yes" dataVal1="Yes" choice1="Yes" dataVal2="No" choice2="No"}}
                                    <br>

                                    {{#parseJSON    '[{"value": "Daily", "text": "Daily"},
                                                        {"value": "Weekly", "text": "Weekly"},
                                                        {"value": "Infrequently", "text": "Infrequently"},
                                                        {"value": "Recovering Alcoholic", "text": "Recovering Alcoholic"}]'}}
                                        {{> custSelect id="alcoholFrequency" label="How often?" emptyOption=true options=this }}
                                    {{/parseJSON}}
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <!--@todo Fix the dataSelected to come from the socialHistory data set-->
                                    {{> custToggle id="useTobacco" label="Do you use tobacco?" dataSelected="Yes" dataVal1="Yes" choice1="Yes" dataVal2="No" choice2="No"}}
                                    <br>
                                    <!--@todo Fix the dataSelected to come from the socialHistory data set-->
                                    {{> custToggle id="useTobaccoWay" label="Preferred way of use?" dataSelected="Smoke" dataVal1="Smoke" choice1="Smoke" dataVal2="Chew" choice2="Chew"}}
                                    <br>

                                    <div class="form-group">
                                        <label for="cigPacksPerDay">Packs a day?</label>
                                        <input type="number" class="form-control" id="cigPacksPerDay"
                                               name="cigPacksPerDay"
                                               aria-describedby="cigPacksPerDay" placeholder="0">
                                    </div>
                                </div>
                            </div>
                            {{> accBtnNext text="Next" submit=true}}
                        </form>
                    </div>
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading" role="tab" id="headingFour">
                    <h4 class="panel-title">
                        <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseFour"
                           aria-expanded="true" aria-controls="collapseFour">
                            Surgical History
                        </a>
                    </h4>
                </div>
                <div id="collapseFour" class="panel-collapse collapse" role="tabpanel"
                     aria-labelledby="headingFour">
                    <div class="panel-body">
                        <form action="" id="surgicalHistory" data-url="/patientMedicalHistory/surgicalHistory">
                            <fieldset>
                                <legend>Please list any <strong>hospitalizations</strong>, <strong>surgeries</strong>,
                                    <strong>fractures</strong> or <strong>major illnesses</strong> you have had.
                                </legend>
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                        <tr>
                                            <th>TYPE OF SURGERY</th>
                                            <th>YEAR or DATE</th>
                                            <th>DOCTOR</th>
                                            <th>LOCATION</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {{#each surgicalHistory}}
                                            <tr>
                                                <td>{{description}} &mdash; {{note}}</td>
                                                <td>{{proceduredate}}</td>
                                                <td>{{providerid}}</td>
                                                <td></td>
                                            </tr>
                                        {{/each}}
                                        <tr class="tableFormInputs">
                                            <td>
                                                <div class="form-group">
                                                    <label for="typeOfSurgery" class="sr-only"></label>
                                                    <input id="typeOfSurgery" name="typeOfSurgery" type="text"
                                                           class="form-control">
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-group">
                                                    <label for="surgeryDate" class="sr-only"></label>
                                                    <input id="surgeryDate" name="surgeryDate" type="text"
                                                           class="form-control">
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-group">
                                                    <label for="surgeryDoctor" class="sr-only"></label>
                                                    <input id="surgeryDoctor" name="surgeryDoctor" type="text"
                                                           class="form-control">
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-group">
                                                    <label for="surgeryLocation" class="sr-only"></label>
                                                    <input id="surgeryLocation" name="surgeryLocation" type="text"
                                                           class="form-control">
                                                </div>
                                            </td>
                                        </tr>
                                        </tbody>
                                        <tfoot>
                                        <tr>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td style="text-align: left;">
                                                <input type="button" class="btn btn-primary btn-block addrow"
                                                       value="Add Row"/>
                                            </td>
                                        </tr>
                                        <tr>
                                        </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </fieldset>
                            {{> accBtnNext text="Next" submit=true}}
                        </form>
                    </div>
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading" role="tab" id="headingFive">
                    <h4 class="panel-title">
                        <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseFive"
                           aria-expanded="true" aria-controls="collapseFive">
                            Medical History
                        </a>
                    </h4>
                </div>
                <div id="collapseFive" class="panel-collapse collapse" role="tabpanel"
                     aria-labelledby="headingFive">
                    <div class="panel-body">
                        <form action="" id="medicalHistory" data-url="/patientMedicalHistory/medicalHistory">
                            <fieldset>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <legend>Have you ever had any of the following?</legend>
                                    </div>
                                </div>
                                <div class="row">
                                    <ul>
                                        {{#each medicalHistory}}
                                            <li>
                                                Q: {{question}} <br>
                                                A: {{answer}} <br>
                                                Q-id: {{questionid}}
                                            </li>
                                        {{/each}}
                                    </ul>
                                </div>
                                <div class="row">
                                    <div class="col-md-3 col-sm-6">
                                        {{> custChkBx text="None of the relatives listed"}}

                                        {{> custChkBx text="Allergies"}}

                                        {{> custChkBx text="Anemia"}}

                                        {{> custChkBx text="Anemia"}}

                                        {{> custChkBx text="Asthma"}}

                                        {{> custChkBx text="Arterial Fibrilation"}}

                                        {{> custChkBx text="Bleeding relatives"}}

                                        {{> custChkBx text="BPH"}}

                                        {{> custChkBx text="Coronary Artery Disease (CAD)"}}

                                        {{> custChkBx text="Cancer"}}

                                        {{> custChkBx text="Cardiac Arrest"}}

                                        {{> custChkBx text="Celiac Disease"}}
                                    </div>
                                    <div class="col-md-3 col-sm-6">

                                        {{> custChkBx text="Chest Pain"}}

                                        {{> custChkBx text="Congestive Heart Failure (CHF)"}}

                                        {{> custChkBx text="Chronic Fatigue Syndrome"}}

                                        {{> custChkBx text="Depression"}}

                                        {{> custChkBx text="Diabetes"}}

                                        {{> custChkBx text="Drug/Alcohol Abuse"}}

                                        {{> custChkBx text="Erectile dysfunction"}}

                                        {{> custChkBx text="Fibromyalgia"}}

                                        {{> custChkBx text="Gerd"}}

                                        {{> custChkBx text="Heart Desease"}}

                                        {{> custChkBx text="High Cholesterol"}}

                                        {{> custChkBx text="Hyperinsulinemia"}}
                                    </div>
                                    <div class="col-md-3 col-sm-6">
                                        {{> custChkBx text="Hyperlipidemia"}}

                                        {{> custChkBx text="Hypertension"}}

                                        {{> custChkBx text="Hypogonadism (male)"}}

                                        {{> custChkBx text="Hypothyroidism"}}

                                        {{> custChkBx text="Infection relatives"}}

                                        {{> custChkBx text="Insomnia"}}

                                        {{> custChkBx text="Irritable Bowel Syndrome"}}

                                        {{> custChkBx text="Kidney relatives"}}

                                        {{> custChkBx text="Menopause"}}

                                        {{> custChkBx text="Migraines/Headaches"}}

                                        {{> custChkBx text="Neuropathy"}}

                                        {{> custChkBx text="Onychomicosis"}}
                                    </div>
                                    <div class="col-md-3 col-sm-6">
                                        {{> custChkBx text="Organ Injury"}}

                                        {{> custChkBx text="Osteoporosis"}}

                                        {{> custChkBx text="Pulmonary embolism/blood clot in legs"}}

                                        {{> custChkBx text="Seizure disorders"}}

                                        {{> custChkBx text="Shortness of breath"}}

                                        {{> custChkBx text="Sinus conditions"}}

                                        {{> custChkBx text="Stroke"}}

                                        {{> custChkBx text="Syndrome X"}}

                                        {{> custChkBx text="Tremors"}}

                                        {{> custChkBx text="Wheat allergy"}}

                                    </div>
                                </div>
                            </fieldset>
                            {{> accBtnNext text="Next" submit=true}}
                        </form>
                    </div>
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading" role="tab" id="headingSix">
                    <h4 class="panel-title">
                        <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseSix"
                           aria-expanded="true" aria-controls="collapseSix">
                            Medications
                        </a>
                    </h4>
                </div>
                <div id="collapseSix" class="panel-collapse collapse" role="tabpanel"
                     aria-labelledby="headingSix">
                    <div class="panel-body">
                        <form action="" id="medications" data-url="/patientMedicalHistory/medications">
                            <fieldset>
                                <legend>
                                    List any medications you are currently taking (please include over the counter
                                    medications).
                                </legend>
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                        <tr>
                                            <th>MEDICATION</th>
                                            <th>DOSAGE</th>
                                            <th>PRESCRIBING DOCTOR</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {{#each medicationHistory.medications}}
                                            <tr>
                                                <td>{{this.0.medication}}</td>
                                                <td>{{this.0.structuredsig.dosagequantityvalue}} {{this.0.structuredsig.dosagequantityunit}}</td>
                                                <td>{{this.0.source}}</td>
                                            </tr>
                                        {{/each}}
                                        <tr class="tableFormInputs">
                                            <td>
                                                <div class="form-group">
                                                    <label for="currMeds" class="sr-only"></label>
                                                    <input id="currMeds" name="currMeds" type="text"
                                                           class="form-control">
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-group">
                                                    <label for="currMedsDosage" class="sr-only"></label>
                                                    <input id="currMedsDosage" name="currMedsDosage" type="text"
                                                           class="form-control">
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-group">
                                                    <label for="currMedsDoc" class="sr-only"></label>
                                                    <input id="currMedsDoc" name="currMedsDoc" type="text"
                                                           class="form-control">
                                                </div>
                                            </td>
                                        </tr>
                                        </tbody>
                                        <tfoot>
                                        <tr>
                                            <td></td>
                                            <td></td>
